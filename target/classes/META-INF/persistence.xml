<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="consultationPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Entity classes -->
        <class>org.consultationsys.models.User</class>
        <class>org.consultationsys.models.Patient</class>
        <class>org.consultationsys.models.Nurse</class>
        <class>org.consultationsys.models.Generalist</class>
        <class>org.consultationsys.models.Specialist</class>
        <class>org.consultationsys.models.Consultation</class>
        <class>org.consultationsys.models.ExpertiseRequest</class>
        <class>org.consultationsys.models.TimeSlot</class>
        <class>org.consultationsys.models.VitalSign</class>
        <class>org.consultationsys.models.WaitingQueue</class>
        <class>org.consultationsys.models.TechnicalProcedure</class>

        <properties>
            <!-- Database Connection Settings -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/consultation_sys"/>
            <property name="jakarta.persistence.jdbc.user" value="gaxown"/>
            <property name="jakarta.persistence.jdbc.password" value="123456"/>

            <!-- Hibernate Settings -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>

            <!-- Disable Bean Validation -->
            <property name="jakarta.persistence.validation.mode" value="NONE"/>
        </properties>
    </persistence-unit>
</persistence>
